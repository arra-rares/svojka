# Deny direct web access to local secrets and the Composer/vendor tree.
<FilesMatch "^(lead-config\.local|smtp-config\.local)\.php$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Deny from all
  </IfModule>
</FilesMatch>

<IfModule mod_rewrite.c>
  RewriteEngine On
  # This directory's rewrite rules replace the site-root rules.
  # /api/lead must be mapped here, or Apache returns 404.
  RewriteRule ^lead$ lead.php [L]
  RewriteRule ^vendor/ - [F,L]
</IfModule>
