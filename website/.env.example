# Local admin + FTP settings (copy to .env.local — never commit)

# Admin login for /manage-events-9xk2
ADMIN_PASSWORD=change-me

# Webhouse FTP upload — use the same host/user/password as Total Commander
FTP_HOST=your-ftp-server-from-webhouse-setup
FTP_USER=your-ftp-username
FTP_PASSWORD=your-ftp-password
FTP_REMOTE_DIR=/www_root/your-domain/
FTP_SECURE_MODE=plain
# FTP_PORT=21

# Password with special characters? Use quotes:
# FTP_PASSWORD="your#complex&password"

# Only if Total Commander uses FTPS instead of plain FTP:
# FTP_SECURE_MODE=explicit
# FTP_TLS_REJECT_UNAUTHORIZED=false

# reCAPTCHA v2 (booking form) — https://www.google.com/recaptcha/admin
VITE_RECAPTCHA_SITE_KEY=your-recaptcha-site-key
RECAPTCHA_SECRET_KEY=your-recaptcha-secret-key
