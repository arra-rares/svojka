# Local admin + FTP settings (copy to .env.local — never commit)

# Admin login for /manage-events-9xk2
ADMIN_PASSWORD=change-me

# Webhouse FTP upload (used by "Upload to website" button)
# Use the FTP hostname from Webhouse SETUP — not ftp.your-domain.sk unless SETUP says so.
FTP_HOST=ftp.example.webhouse.sk
FTP_USER=your-ftp-username
FTP_PASSWORD=your-ftp-password
FTP_REMOTE_DIR=/www/domains/your-domain.sk
FTP_SECURE_MODE=explicit
# TLS: Webhouse shared FTP often fails strict cert checks — leave false unless you know you need strict.
FTP_TLS_REJECT_UNAUTHORIZED=false
# If you must use an IP as FTP_HOST, set the hostname from SETUP here:
# FTP_TLS_SERVERNAME=ftp.example.webhouse.sk
# FTP_PORT=21
